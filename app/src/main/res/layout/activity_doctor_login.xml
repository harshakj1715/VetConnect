<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F8F7FC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐾"
        android:textSize="56sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Doctor Login"
        android:textColor="#29213D"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign in to manage veterinary care"
        android:textColor="#777184"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="28dp"/>

    <EditText
        android:id="@+id/etDoctorLoginEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email address"
        android:inputType="textEmailAddress"
        android:autofillHints="username"
        android:padding="14dp"
        android:backgroundTint="#7B61A8"/>

    <EditText
        android:id="@+id/etDoctorLoginPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword"
        android:autofillHints="password"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#7B61A8"/>

    <Button
        android:id="@+id/btnDoctorLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7654A6"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/tvDoctorForgotPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Forgot password?"
        android:textColor="#7654A6"
        android:gravity="center"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/tvDoctorRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New veterinarian? Register here"
        android:textColor="#7654A6"
        android:gravity="center"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>