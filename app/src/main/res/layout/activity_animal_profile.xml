<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- PAGE TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐾 Animal Profile"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- ANIMAL PROFILE CARD -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Animal Name -->

                <TextView
                    android:id="@+id/txtAnimalName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rocky"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32" />

                <!-- Type -->

                <TextView
                    android:id="@+id/txtAnimalType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type : Dog"
                    android:textSize="17sp"
                    android:textColor="#444444"
                    android:layout_marginTop="12dp" />

                <!-- Breed -->

                <TextView
                    android:id="@+id/txtBreed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Breed : German Shepherd"
                    android:textSize="17sp"
                    android:textColor="#444444"
                    android:layout_marginTop="7dp" />

                <!-- Age -->

                <TextView
                    android:id="@+id/txtAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age : 3 Years"
                    android:textSize="17sp"
                    android:textColor="#444444"
                    android:layout_marginTop="7dp" />

                <!-- Gender -->

                <TextView
                    android:id="@+id/txtGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender : Male"
                    android:textSize="17sp"
                    android:textColor="#444444"
                    android:layout_marginTop="7dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- HEALTH RECORDS TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 Health Records"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />


        <!-- NO RECORDS MESSAGE -->

        <TextView
            android:id="@+id/tvNoRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No health records available"
            android:textSize="16sp"
            android:textColor="#777777"
            android:gravity="center"
            android:padding="25dp"
            android:visibility="gone" />


        <!-- HEALTH RECORDS LIST -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMedicalRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>