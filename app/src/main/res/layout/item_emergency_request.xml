<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvRequestAnimalName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Animal Name"
        android:textColor="#243329"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRequestAnimalType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Animal Type"
        android:textColor="#718071"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvRequestDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Emergency description"
        android:textColor="#374237"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvRequestStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="PENDING"
        android:textColor="#D97706"
        android:textStyle="bold"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnAcceptRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#2E7D32"
        android:text="Accept Request"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

</LinearLayout>
