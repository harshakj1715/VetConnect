<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐾"
            android:textSize="44sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Join VetConnect"
            android:textColor="#29213D"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create your veterinary account"
            android:textColor="#777184"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etDoctorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full name"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:backgroundTint="#7B61A8"/>

        <EditText
            android:id="@+id/etDoctorEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#7B61A8"/>

        <EditText
            android:id="@+id/etDoctorPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone number"
            android:inputType="phone"
            android:maxLength="10"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#7B61A8"/>

        <EditText
            android:id="@+id/etDoctorQualification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Qualification (e.g. BVSc &amp; AH)"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#7B61A8"/>

        <EditText
            android:id="@+id/etDoctorSpecialization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Specialization"
            android:inputType="textCapWords"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#7B61A8"/>

        <EditText
            android:id="@+id/etDoctorPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password (at least 6 characters)"
            android:inputType="textPassword"
            android:autofillHints="newPassword"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#7B61A8"/>

        <EditText
            android:id="@+id/etDoctorConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirm password"
            android:inputType="textPassword"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#7B61A8"/>

        <Button
            android:id="@+id/btnDoctorRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Doctor Account"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7654A6"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/tvDoctorGoToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Already registered? Login"
            android:textColor="#7654A6"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>
</ScrollView>
