<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnProfileBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back to Dashboard"
            android:textColor="#2E7D32"
            android:textSize="16sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Doctor Profile"
            android:textColor="#204D2A"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your account information"
            android:textColor="#687568"
            android:textSize="15sp"
            android:layout_marginTop="6dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvProfileDoctorInitial"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="#E1F0DF"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="#2E7D32"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doctor Account"
                    android:textColor="#204D2A"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registered Email"
                    android:textColor="#687568"
                    android:textSize="13sp"
                    android:layout_marginTop="24dp" />

                <TextView
                    android:id="@+id/tvProfileDoctorEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="doctor@example.com"
                    android:textColor="#263528"
                    android:textSize="16sp"
                    android:layout_marginTop="5dp"
                    android:textIsSelectable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E4EAE1"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Firebase User ID"
                    android:textColor="#687568"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvProfileDoctorId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="User ID"
                    android:textColor="#263528"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnProfileLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />

    </LinearLayout>

</ScrollView>
