<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="horizontal"

    android:paddingBottom="16dp">


    <!-- ================================= -->
    <!-- LEFT TIMELINE -->
    <!-- ================================= -->

    <LinearLayout

        android:layout_width="82dp"
        android:layout_height="match_parent"

        android:orientation="vertical"

        android:gravity="center_horizontal">


        <!-- Calendar Circle -->

        <com.google.android.material.card.MaterialCardView

            android:layout_width="54dp"
            android:layout_height="54dp"

            app:cardCornerRadius="27dp"
            app:cardElevation="0dp"

            app:cardBackgroundColor="#F2EAFE">


            <TextView

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"

                android:text="📅"
                android:textSize="22sp"/>

        </com.google.android.material.card.MaterialCardView>


        <!-- Date -->

        <TextView
            android:id="@+id/tvTimelineDate"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="12 APR"

            android:textColor="#6136A8"
            android:textSize="13sp"
            android:textStyle="bold"

            android:layout_marginTop="8dp"/>


        <TextView
            android:id="@+id/tvTimelineYear"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="2026"

            android:textColor="#555555"
            android:textSize="13sp"

            android:layout_marginTop="2dp"/>


        <!-- Timeline -->

        <View

            android:layout_width="2dp"
            android:layout_height="70dp"

            android:background="#D9D1E8"

            android:layout_marginTop="8dp"/>

    </LinearLayout>


    <!-- ================================= -->
    <!-- RECORD CARD -->
    <!-- ================================= -->

    <com.google.android.material.card.MaterialCardView

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="1"

        app:cardCornerRadius="19dp"
        app:cardElevation="1dp"

        app:strokeWidth="1dp"
        app:strokeColor="#E9E3F1"

        app:cardBackgroundColor="#FFFFFF">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">


            <!-- ================================= -->
            <!-- CARD HEADER -->
            <!-- ================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:gravity="center_vertical"

                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"

                android:background="#FAF8FE">


                <com.google.android.material.card.MaterialCardView

                    android:layout_width="42dp"
                    android:layout_height="42dp"

                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"

                    app:cardBackgroundColor="#F2EAFE">


                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:gravity="center"

                        android:text="✚"

                        android:textColor="#6236A8"
                        android:textSize="21sp"
                        android:textStyle="bold"/>

                </com.google.android.material.card.MaterialCardView>


                <TextView
                    android:id="@+id/tvRecordTitle"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="Health Checkup"

                    android:textColor="#161616"
                    android:textSize="17sp"
                    android:textStyle="bold"

                    android:layout_marginStart="10dp"/>


                <!-- Completed -->

                <TextView
                    android:id="@+id/tvStatus"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Completed"

                    android:textColor="#216B32"
                    android:textSize="12sp"
                    android:textStyle="bold"

                    android:background="#EAF6EA"

                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"/>


                <!-- Menu -->

                <TextView

                    android:layout_width="25dp"
                    android:layout_height="40dp"

                    android:gravity="center"

                    android:text="⋮"

                    android:textColor="#6236A8"
                    android:textSize="25sp"

                    android:layout_marginStart="2dp"/>

            </LinearLayout>


            <!-- ================================= -->
            <!-- CARD CONTENT -->
            <!-- ================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="14dp">


                <!-- Doctor -->

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal">


                    <TextView

                        android:layout_width="70dp"
                        android:layout_height="wrap_content"

                        android:text="Doctor"

                        android:textColor="#555555"
                        android:textSize="14sp"/>


                    <TextView
                        android:id="@+id/tvDoctor"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="Not Available"

                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- ================================= -->
                <!-- THREE MEDICAL FIELDS -->
                <!-- ================================= -->

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"

                    android:layout_marginTop="16dp">


                    <!-- Disease -->

                    <LinearLayout

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical">


                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="🐾  Disease"

                            android:textColor="#687078"
                            android:textSize="13sp"/>


                        <TextView
                            android:id="@+id/tvDisease"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:text="viral &amp; bacteria"

                            android:textColor="#202020"
                            android:textSize="14sp"
                            android:textStyle="bold"

                            android:layout_marginTop="5dp"/>

                    </LinearLayout>


                    <!-- Medicine -->

                    <LinearLayout

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical"

                        android:layout_marginStart="8dp">


                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="💊  Medicine"

                            android:textColor="#687078"
                            android:textSize="13sp"/>


                        <TextView
                            android:id="@+id/tvMedicine"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:text="Amoxicillin"

                            android:textColor="#202020"
                            android:textSize="14sp"
                            android:textStyle="bold"

                            android:layout_marginTop="5dp"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- ================================= -->
                <!-- VACCINATION -->
                <!-- ================================= -->

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:layout_marginTop="14dp">


                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="💉  Vaccination"

                        android:textColor="#687078"
                        android:textSize="13sp"/>


                    <TextView
                        android:id="@+id/tvVaccination"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Amoxicillin"

                        android:textColor="#202020"
                        android:textSize="14sp"
                        android:textStyle="bold"

                        android:layout_marginTop="5dp"/>

                </LinearLayout>


                <!-- ================================= -->
                <!-- NOTES -->
                <!-- ================================= -->

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:layout_marginTop="14dp">


                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Notes"

                        android:textColor="#687078"
                        android:textSize="13sp"/>


                    <TextView
                        android:id="@+id/tvNotes"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="nothing"

                        android:textColor="#202020"
                        android:textSize="14sp"
                        android:textStyle="bold"

                        android:layout_marginTop="5dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
